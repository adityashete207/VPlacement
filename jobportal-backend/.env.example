# Copy this file to .env and fill in real values. Never commit your actual .env.

# --- Existing app config (unchanged) ---
PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jobportal

# --- New: AI layer (Google Gemini) ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the model used by every agent (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite
